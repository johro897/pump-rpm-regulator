# Copy to secrets.yaml and fill in real values. secrets.yaml is gitignored.
wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"
api_key: "generate with: python -c \"import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())\""
api_key_presence: "generate the same way as api_key"
ota_password: "your_ota_password"

# Network — your device's static IP config. Pick free addresses on your own LAN.
static_ip: 192.168.1.72
gateway: 192.168.1.1
subnet: 255.255.255.0
ap_fallback_password: "choose_a_fallback_ap_password"
